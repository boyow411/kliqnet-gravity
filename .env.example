# Database (required)
# Use a Neon/Postgres connection string with SSL in production.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth (required)
# NEXTAUTH_URL should be the deployed app URL in production, e.g. https://kliqnetdigital.com
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# Optional app/admin settings
# Public site URL used by emails/canonical links where needed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required only when running database seed scripts that create/update the first admin user.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-strong-one-time-password"

# Notes:
# - Do not commit real secrets.
# - Seed a real SUPER_ADMIN or ADMIN user in the database; there are no fallback admin credentials.
